# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gulhub
CLIENT_BASE_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_long_random_string
PORT=5000
NODE_ENV=development

# --- Optional ---
# Raises GitHub API limit from 60 to 5000 requests/hour (needs no scopes)
GITHUB_API_KEY=
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
